# Copy this file to .postgres.env and replace every REPLACE value.
# APP_DB_PASSWORD must match the password stored in the restored n8n PostgreSQL
# credential, or you must update that credential in n8n before testing memory.

POSTGRES_USER=superadmin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
POSTGRES_DB=postgres
APP_DB_USER=skin_chat_app
APP_DB_PASSWORD=REPLACE_WITH_EXISTING_OR_NEW_APP_PASSWORD
APP_DB_NAME=skin_chat_memory
