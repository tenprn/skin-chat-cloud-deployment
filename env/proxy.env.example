# Copy this file to .proxy.env. DNS for N8N_DOMAIN must point to the VM before
# Caddy can obtain the public TLS certificate.

N8N_DOMAIN=automation.example.com
ACME_EMAIL=admin@example.com
# Exact production path shown by the n8n Webhook node. Do not include the domain.
LINE_WEBHOOK_PATH=/webhook/REPLACE_WITH_N8N_LINE_WEBHOOK_PATH
