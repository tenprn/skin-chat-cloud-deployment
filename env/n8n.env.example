# Copy this file to .n8n.env and replace the example domain.
# Do not set N8N_ENCRYPTION_KEY to a new value. The restored n8n volume already
# contains the existing encryption configuration. If you later move the key to
# a secret manager, use the exact existing key.

N8N_HOST=automation.example.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://automation.example.com/
N8N_EDITOR_BASE_URL=https://automation.example.com/
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=true
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000
TZ=Asia/Bangkok
GENERIC_TIMEZONE=Asia/Bangkok
